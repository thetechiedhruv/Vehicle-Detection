# =============================================================================
# PLATESCOPE EDGE — plate_edge.py configuration
# Copy to .env and fill in.  .env is gitignored; .env.example is not.
# =============================================================================

# --- Central server (leave blank to run fully standalone) --------------------
SITE_ID=

# Edge API Key (Keep this secret!)
EDGE_API_KEY=

# Central Server API URL
CENTRAL_API_URL=

SITE_NAME=

# Endpoint paths on the central server.
#
# EP_DETECTIONS is the one the backend implements: it takes the plate number
# and the image it was read from, and answers 201. The others are optional and
# self-disable if the server answers "Route not found".
EP_DETECTIONS=/edge/detections
EP_CAMERAS=/edge/cameras
EP_REGISTERED=/edge/vehicles/sync
EP_HEARTBEAT=/edge/heartbeat

# Image uploaded with each detection: jpg (default) or png.
DETECTION_FORMAT=jpg

# Width the vehicle crop is scaled to before encoding. Larger means a more
# legible plate in review and a bigger upload; the server rejects bodies
# over 10MB.
SNAPSHOT_WIDTH=640

# --- Testing with a video file ------------------------------------------------
# Point TEST_VIDEO at a clip and plate_edge runs it through the whole pipeline
# — detection, voting, snapshots, local database, MJPEG preview — as if it were
# a camera. Watch it at http://localhost:8002/stream/<TEST_VIDEO_ID>
#
# Leave blank for normal operation.
TEST_VIDEO=
TEST_VIDEO_ID=test-video

# Loop the clip when it ends.
TEST_VIDEO_LOOP=true

# Off by default on purpose: a looping test clip would post a detection to the
# central server on every lap. Set true only with a cameraId registered there.
TEST_VIDEO_UPLOAD=false

# --- Cameras ------------------------------------------------------------------
# Cameras are NOT configured here any more. The service reads them from the
# central server at startup and every CAMERA_SYNC_INTERVAL seconds:
#
#   GET {CENTRAL_API_URL}/edge/detections/cameras
#   -> data.cameras[] of { id, name, streamUrl }
#
# Each camera's `id` is used verbatim as the cameraId when posting detections,
# so it always matches what the server expects. Add or remove a camera on the
# server and this service follows within CAMERA_SYNC_INTERVAL - no restart.
#
# That route needs no API key, so cameras still load even if EDGE_API_KEY is
# wrong (uploads would fail, but the video and local logging keep working).

EP_CAMERA_LIST=/edge/detections/cameras

# How often to re-read the camera list, in seconds.
CAMERA_SYNC_INTERVAL=120

# Last known camera list. If the server is unreachable at startup, the service
# falls back to this so the road cameras still come up.
CAMERA_CACHE_PATH=./data/cameras.json

# One plate model and one OCR engine shared by every camera, behind a lock.
# Each camera still gets its own vehicle model - the tracker keeps state on it.
# Turning this off costs well over a gigabyte of RAM per extra camera.
SHARE_MODELS=true

# Seconds between starting one camera and the next, so several model loads do
# not spike memory and CPU at the same moment.
CAMERA_START_STAGGER=3.0

# --- Models ------------------------------------------------------------------
# Read by plate_scan.py at import time.
#
# Measured on this hardware (4-core i5-6500, CPU only, no GPU), plate stage only,
# over videos/car_plates.mp4 and videos/bike_plates.mp4:
#
#   license-plate-finetune-v1x.pt  57M params   979ms/pass   9 plates on bikes
#   license_plate_detector.pt       3M params   129ms/pass   9 plates on bikes
#   plate_yolov8n.pt                3M params   282ms/pass   6 plates on bikes
#
# The v1x model is 7.6x the cost for exactly the same plates — it is a YOLOv8x
# fine-tune, and this box has no GPU to hide that on. plate_yolov8n is not the
# alternative it looks like: it invents plate boxes (97 vs 82 on the same
# footage), and every false box costs a full ~200ms OCR call, which is why its
# pass time is worse than the model it is a third the size of.
#
# Those saved milliseconds are what fast vehicles are short of: they buy more
# looks per vehicle, which is what actually gets a plate read.
PLATE_MODEL_PATH=models/license_plate_detector.pt
# Vehicle detector. Measured on this box over videos/video1.mp4, the busiest
# footage (mixed cars, trucks, buses, bikes) — total boxes over 50 frames:
#
#   yolo12m.pt @480   171ms   630 boxes   (bus 49 car 255 bike 152 truck 174)
#   yolo26s.pt @480    67ms   534 boxes   (bus 45 car 228 bike 154 truck 107)
#   yolo26s.pt @640   114ms   703 boxes   (bus 66 car 302 bike 185 truck 150)
#
# Note the imgsz, not just the model. yolo26s at 480 is the fastest of these and
# the wrong choice: it drops 38% of the trucks, because a truck far enough away
# is small in the frame and 480 throws away the pixels that made it a truck.
# At 640 it finds more of every class than the model three times its cost.
#
# So: a third off the vehicle stage AND better recall on trucks and buses,
# which is what VEHICLE_IMGSZ=640 is buying here.
VEHICLE_MODEL_PATH=yolo26s.pt

# --- Detection tuning --------------------------------------------------------
# Minimum seconds between detection passes on one camera — a throttle, not a
# target. Leave at 0 to look at every frame the detector has time for.
#
# This used to default to 0.4 because capture and detection shared a thread: the
# pause was the only thing stopping the decoder queue from filling while a pass
# ran. Capture now has its own thread, so the pause buys nothing and costs looks
# per vehicle, which is what fast traffic is short of.
#
# Raise it only to hand cycles back to other cameras or to the rest of the box.
DETECT_INTERVAL=0

VEHICLE_IMGSZ=640
VEHICLE_CONF=0.3

# The floor for the plate detector's inference size. A vehicle crop larger than
# this is run nearer its own size, up to PLATE_IMGSZ_MAX — a lorry filling the
# frame squeezed into 320 loses its plate entirely, which fixed-320 was doing.
PLATE_IMGSZ=320
PLATE_IMGSZ_MAX=480
PLATE_CONF=0.35

# --- OCR gates ---------------------------------------------------------------
# OCR is the most expensive step in the pipeline (~200ms per plate on this
# hardware). These two drop crops it could never read anyway, before paying for
# them — and, just as importantly, stop the garbage strings they produce from
# competing with real reads in the vote.
#
# A plate box narrower than this has no readable characters left.
MIN_PLATE_WIDTH=40

# Variance-of-Laplacian floor: below it the crop is motion-blurred past reading,
# which is exactly what a fast vehicle produces. Set 0 to disable the gate.
# Check skippedBlur in /status against real footage before raising it — set too
# high, this throws away the fast vehicles you are trying to catch.
BLUR_MIN=45

# --- Plate text structure ----------------------------------------------------
# Read OCR output as an Indian plate (LL-DD-LL-DDDD) instead of as a bare
# string. Measured against every distinct string this service has read from
# live cameras, 49 of 68 break that pattern — and every one of those is a
# misread, because the correct plates in the same log all fit it.
#
# Knowing the structure allows three things character cleaning cannot:
#   * repair by position — a 6 in the state code is a G, a B in the number is
#     an 8. One global confusion table cannot express that, because which way
#     to convert depends on where the character sits.
#   * strip junk from the ends — FHR26BT1607, GJ278104H. A bolt, a screw or the
#     plate border read as a character, with the plate intact underneath.
#   * reject what cannot be a plate — XYS178, 158SEF8679, a truncated
#     26BT1607. These used to enter the vote and could win it.
PLATE_FORMAT=true
PLATE_FORMAT_STRICT=true

# State codes this site actually sees, comma separated. A reading whose code is
# outside the list loses to one inside it that is a single confusion away.
#
# This is what fixes AR26BT1607 -> HR26BT1607: AR is a real code, so nothing
# about the structure is wrong, but A and H look alike and this site sees HR
# every day while Arunachal Pradesh is 2,000km away.
#
# The trade: a genuine vehicle from an unlisted state is reported as the local
# lookalike. List every state you really see, or leave blank to disable.
PLATE_STATES=GJ,HR

# How far to disbelieve an unlisted state, in units of character repairs. Above
# 1.0 a local plate one confusion away beats a distant one needing no repair.
PLATE_STATE_PENALTY=1.5

# Reads that must agree before a plate is committed.
#
# Measured on videos/bike_plates.mp4 (9 bikes, ground truth known), live
# per-vehicle voting as this service does it:
#   MIN_VOTES=2, DETECT_EVERY_N=10 -> 8 plates, 2 degraded, 1 missed
#   MIN_VOTES=3, DETECT_EVERY_N=6  -> 9 plates, all correct
#
# At 2 the vote closes on the first two agreeing reads and stops scanning that
# vehicle, so a truncated read like BG0244 locks in before the full GJ27BG0244
# is ever seen. 3 is the better default.
#
# Raise to 4 only if wrong plates still get through; each extra vote needs the
# vehicle to stay in frame longer, so fast traffic starts getting missed.
MIN_VOTES=3

# --- Catching fast vehicles --------------------------------------------------
# MIN_VOTES needs a vehicle to stay in frame long enough to be read several
# times. A vehicle crossing the frame in under a second cannot do that, and used
# to be logged as "unread" and thrown away however clearly its plate was seen.
# These two are the way out, and they are why MIN_VOTES can stay at 3.
#
# A single read this confident commits immediately, without waiting for
# MIN_VOTES. Set high — it decides on one read. 0 disables.
HIGH_CONF_COMMIT=0.9

# Last chance for a vehicle leaving the frame still below MIN_VOTES: emit it if
# its best read has at least this many votes and this confidence. Such events
# carry "provisional": true, so a consumer can tell them from a full vote.
#
# Lower EXIT_MIN_CONF to catch more fast vehicles at the cost of more wrong
# plates; raise it if provisional reads are coming through wrong.
EXIT_MIN_VOTES=1
EXIT_MIN_CONF=0.75

# Tracker settings. The shipped file turns off global motion compensation,
# which only makes sense for a camera that moves and otherwise burns CPU on
# every frame (and produces the "not enough matching points" warnings).
# Leave blank to use ultralytics' own botsort.yaml.
TRACKER_CONFIG=trackers/fixed_camera.yaml

# Seconds a vehicle can be unseen before its track is finalized and dropped.
TRACK_TTL=3.0

# Same plate on the same camera inside this many seconds counts as one visit.
# Absorbs the tracker losing a vehicle and re-acquiring it under a new ID.
PLATE_COOLDOWN=60

# --- Duplicate suppression ---------------------------------------------------
# PLATE_COOLDOWN above is keyed per camera. Measured against the local history,
# it works: not one same-camera repeat inside 60 seconds. Every duplicate that
# actually reached the server was the same plate under a *different* cameraId,
# which a per-camera key cannot catch by definition.
#
# This window is keyed on the plate alone, across every camera. A plate any
# camera reported inside DEDUPE_WINDOW seconds is still logged locally, and is
# not uploaded again. The JSON file is the record: plate, cameraId, cameraName
# and time, pruned on every check. GET /recent-plates shows it live.
#
# 5 seconds catches roughly half the duplicates in the current history — the
# cross-camera repeats cluster at 0.4-6s, but a second group sits at 20-45s.
# Raise to 60 to catch all of them; that is also the window at which this
# matches PLATE_COOLDOWN, so the two agree.
DEDUPE_WINDOW=5
DEDUPE_FILE=./data/recent_plates.json

# Edit distance allowed when matching a read against the registered list.
# Keep low: a loose match authorizes the wrong vehicle.
MATCH_MAX_DISTANCE=1

# --- Service -----------------------------------------------------------------
SYNC_INTERVAL=300
HEARTBEAT_INTERVAL=30

LOCAL_DB_PATH=./data/plates.db
PLATE_DB_PATH=./data/registered_plates.json

HOST=0.0.0.0
PORT=8002
